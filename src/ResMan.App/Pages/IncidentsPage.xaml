<Page
    x:Class="ResMan.App.Pages.IncidentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ResMan.App.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Band" CornerRadius="0,0,0,14" Padding="36,46,36,22">
            <Grid ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="10" VerticalAlignment="Bottom">
                    <TextBlock x:Name="BandLabel" Style="{StaticResource BandLabel}" Text="INCIDENTS" />
                    <TextBlock x:Name="Headline" Style="{StaticResource Headline}" FontSize="44" LineHeight="46" Text="Looking for incidents…" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Bottom">
                    <StackPanel>
                        <TextBlock x:Name="TimeNum" Style="{StaticResource Numeral}" FontSize="88" LineHeight="76" Text="" />
                        <TextBlock x:Name="TimeLabel" FontFamily="{StaticResource WordsFont}" FontWeight="SemiBold" FontSize="14" />
                    </StackPanel>
                    <Button x:Name="PlayButton" Width="56" Height="56" CornerRadius="28" Padding="0" VerticalAlignment="Center"
                            AutomationProperties.Name="Play the black-box minute" Click="OnPlay" Style="{StaticResource PrimaryButton}">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- All incidents, newest first -->
            <ScrollViewer Padding="36,20,12,20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="LAST 7 DAYS" />
                    <StackPanel x:Name="List" />
                    <Border Style="{StaticResource RowRule}" />
                    <TextBlock x:Name="ListEmpty" Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed"
                               Text="Nothing has gone wrong in the last week. Hindsight keeps recording in the background." />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Padding="24,20,36,24" ColumnSpacing="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="ChartPanel" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="16" Height="3" Style="{StaticResource InkFill}" VerticalAlignment="Center" /><TextBlock Style="{StaticResource Mono}" FontSize="11" Text="MEMORY" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="16" Height="1" Style="{StaticResource InkFill}" VerticalAlignment="Center" /><TextBlock Style="{StaticResource Mono}" FontSize="11" Text="CPU" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="16" Height="2" Style="{StaticResource InkFill}" Opacity="0.5" VerticalAlignment="Center" /><TextBlock Style="{StaticResource Mono}" FontSize="11" Text="DISK" /></StackPanel>
                        </StackPanel>
                        <Border BorderBrush="{ThemeResource InkBrush}" BorderThickness="0,1.5,0,1.5">
                            <Grid x:Name="ChartArea" Height="250" PointerMoved="OnScrub" PointerPressed="OnScrub" Background="Transparent">
                                <c:TraceCanvas x:Name="Chart" />
                                <TextBlock x:Name="DangerLabel" Style="{StaticResource SignalMono}" FontSize="10" HorizontalAlignment="Right" Margin="0,30,4,0" VerticalAlignment="Top" Text="90%" />
                                <Canvas x:Name="Overlay" IsHitTestVisible="False">
                                    <Border x:Name="Playhead" Width="2" Style="{StaticResource InkFill}" />
                                    <Border x:Name="Readout" CornerRadius="4" Padding="8,4" Style="{StaticResource InkFill}">
                                        <TextBlock x:Name="ReadoutText" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{ThemeResource OnInkBrush}" />
                                    </Border>
                                </Canvas>
                                <TextBlock x:Name="NoReplay" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                           MaxWidth="420" Visibility="Collapsed"
                                           Text="There's no black-box recording for this one. Hindsight saves the minute before each freeze and crash it sees from now on." />
                            </Grid>
                        </Border>
                        <Grid>
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="−60 S" />
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Center" Text="−30 S" />
                            <TextBlock Style="{StaticResource SignalMono}" FontSize="11" HorizontalAlignment="Right" Text="INCIDENT" />
                        </Grid>
                        <Grid x:Name="Moments" ColumnSpacing="14" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="18">
                        <StackPanel>
                            <TextBlock x:Name="ProgramsLabel" Style="{StaticResource SectionLabel}" Text="BIGGEST PROGRAMS" />
                            <StackPanel x:Name="Programs" />
                            <Border Style="{StaticResource RowRule}" />
                            <TextBlock x:Name="GrewNote" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="NarrationLabel" Style="{StaticResource SectionLabel}" Text="WHAT HAPPENED, IN WORDS" />
                            <Border Style="{StaticResource StrongRule}" Padding="0,12,0,0">
                                <TextBlock x:Name="Narration" Style="{StaticResource Body}" FontSize="19" LineHeight="26" FontWeight="SemiBold" CharacterSpacing="-10"
                                           Text="Let the local AI tell the story of this minute." />
                            </Border>
                            <StackPanel Spacing="8" Margin="0,6,0,0">
                                <Button x:Name="NarrateButton" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Content="Tell me what happened" Click="OnNarrate" />
                                <Button x:Name="ExplainButton" HorizontalAlignment="Left" Style="{StaticResource LinkButtonPlain}" Content="Ask why →" Click="OnExplain" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
