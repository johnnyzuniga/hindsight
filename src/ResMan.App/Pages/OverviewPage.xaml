<Page
    x:Class="ResMan.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ResMan.App.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The state band: its color is the PC's health at a glance. -->
        <Border x:Name="Band" CornerRadius="0,0,0,14" Padding="36,46,36,14">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="BandLabel" Style="{StaticResource BandLabel}" Text="LOOKING…" />
                    <TextBlock x:Name="BandRight" Style="{StaticResource BandLabel}" HorizontalAlignment="Right" Text="LAST HOUR" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom" Spacing="8">
                        <TextBlock x:Name="Headline" Style="{StaticResource Headline}" Text=" " />
                        <TextBlock x:Name="Detail" FontFamily="{StaticResource WordsFont}" FontSize="16" LineHeight="23" TextWrapping="Wrap" Opacity="0.85" MaxWidth="560" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="22" VerticalAlignment="Bottom">
                        <StackPanel>
                            <TextBlock x:Name="CrashNum" Style="{StaticResource Numeral}" Text="–" />
                            <TextBlock x:Name="CrashLabel" FontFamily="{StaticResource WordsFont}" FontWeight="SemiBold" FontSize="15" Text="crashes in 24 h" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="FreezeNum" Style="{StaticResource Numeral}" Text="–" />
                            <TextBlock x:Name="FreezeLabel" FontFamily="{StaticResource WordsFont}" FontWeight="SemiBold" FontSize="15" Text="freezes in 24 h" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="MemNum" Style="{StaticResource Numeral}" Text="–" />
                            <TextBlock x:Name="MemLabel" FontFamily="{StaticResource WordsFont}" FontWeight="SemiBold" FontSize="15" Text="memory in use" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Hero trace: memory over the last hour, incidents marked underneath. -->
                <Grid Grid.Row="2" Height="140" Margin="0,4,0,0">
                    <c:TraceCanvas x:Name="Trace" />
                    <TextBlock x:Name="ThresholdLabel" Style="{StaticResource BandLabel}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,0,0" Opacity="0.75" Text="90%" />
                    <TextBlock x:Name="EmptyTrace" Style="{StaticResource BandLabel}" VerticalAlignment="Center" Visibility="Collapsed"
                               Text="NO RESOURCE SAMPLES YET. IS THE RESMAN SERVICE RUNNING?" />
                </Grid>
                <StackPanel Grid.Row="3" Spacing="4">
                    <Border x:Name="MarkerRule" BorderThickness="0,1.5,0,0" Height="18">
                        <Canvas x:Name="Markers" />
                    </Border>
                    <Grid x:Name="Axis">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="36,22,36,0" ColumnSpacing="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="OPEN" />
                    <StackPanel x:Name="OpenList" />
                    <Border Style="{StaticResource RowRule}" />
                    <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock x:Name="GoodLabel" Style="{StaticResource SectionLabel}" Text="YOUR LAST FIX" />
                    <Border Style="{StaticResource RowRule}" Padding="0,10,0,0">
                        <StackPanel Spacing="8">
                            <StackPanel x:Name="FixRow" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                                <TextBlock x:Name="FixNum" Style="{StaticResource SmallNumeral}" FontSize="44" />
                                <TextBlock x:Name="FixUnit" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </StackPanel>
                            <TextBlock x:Name="FixText" Style="{StaticResource Body}" FontSize="14" LineHeight="21" />
                            <TextBlock x:Name="CalmText" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="36,14,36,20" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AskBox" Style="{StaticResource AskBox}" PlaceholderText="Tell ResMan what's wrong, in your own words"
                     AutomationProperties.Name="Describe what's wrong" KeyDown="OnAskKey" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinHeight="48" Content="Investigate" Click="OnAsk" />
        </Grid>
    </Grid>
</Page>
