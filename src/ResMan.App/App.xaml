<Application
    x:Class="ResMan.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Keep text fields on our palette in every state instead of Fluent's accent colors. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F7F6F3" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B9B6AE" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#141414" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#141414" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#63625D" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A8880" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#E8590C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1C1C1A" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0F0F0E" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4A4944" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#ECEAE4" />
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#ECEAE4" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#9C9A93" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#77756F" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#DB520B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
