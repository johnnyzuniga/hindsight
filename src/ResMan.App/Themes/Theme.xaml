<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Direction D, "Instrument": warm grey ground, ink type, one signal color that only ever means "problem".
      Every color is a theme resource, so switching Light/Dark repaints in place.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="GroundColor">#EFEEEA</Color>
            <SolidColorBrush x:Key="GroundBrush" Color="#EFEEEA" />
            <SolidColorBrush x:Key="FieldBrush" Color="#F7F6F3" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#D3D1CA" />
            <SolidColorBrush x:Key="TrackBrush" Color="#E2DFD7" />
            <SolidColorBrush x:Key="InkBrush" Color="#141414" />
            <SolidColorBrush x:Key="InkSoftBrush" Color="#46453F" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#63625D" />
            <SolidColorBrush x:Key="SignalBrush" Color="#D9480F" />
            <SolidColorBrush x:Key="SignalTextBrush" Color="#B63A0A" />
            <SolidColorBrush x:Key="OnInkBrush" Color="#EFEEEA" />
            <Color x:Key="BandGoodColor">#1F4D3A</Color>
            <Color x:Key="BandAttentionColor">#E8590C</Color>
            <Color x:Key="BandProblemColor">#A8261A</Color>
            <Color x:Key="BandNeutralColor">#141414</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="GroundColor">#141413</Color>
            <SolidColorBrush x:Key="GroundBrush" Color="#141413" />
            <SolidColorBrush x:Key="FieldBrush" Color="#1C1C1A" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#2E2D2A" />
            <SolidColorBrush x:Key="TrackBrush" Color="#262522" />
            <SolidColorBrush x:Key="InkBrush" Color="#ECEAE4" />
            <SolidColorBrush x:Key="InkSoftBrush" Color="#C9C6BE" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#9C9A93" />
            <SolidColorBrush x:Key="SignalBrush" Color="#F26A2E" />
            <SolidColorBrush x:Key="SignalTextBrush" Color="#FF8A57" />
            <SolidColorBrush x:Key="OnInkBrush" Color="#141413" />
            <!-- Dark mode keeps the hero dark: a tinted band, with the state color carried by the accents. -->
            <Color x:Key="BandGoodColor">#12261D</Color>
            <Color x:Key="BandAttentionColor">#2A1609</Color>
            <Color x:Key="BandProblemColor">#2E0F0C</Color>
            <Color x:Key="BandNeutralColor">#1E1D1A</Color>
            <Color x:Key="AccentGoodColor">#5FD49A</Color>
            <Color x:Key="AccentAttentionColor">#FF8A4C</Color>
            <Color x:Key="AccentProblemColor">#FF6B5E</Color>
            <Color x:Key="AccentNeutralColor">#ECEAE4</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="GroundColor">Black</Color>
            <SolidColorBrush x:Key="GroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FieldBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InkSoftBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SignalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SignalTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OnInkBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <Color x:Key="BandGoodColor">Black</Color>
            <Color x:Key="BandAttentionColor">Black</Color>
            <Color x:Key="BandProblemColor">Black</Color>
            <Color x:Key="BandNeutralColor">Black</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Bundled OFL fonts: work offline, never fall back to Segoe. -->
    <FontFamily x:Key="WordsFont">ms-appx:///Assets/Fonts/SchibstedGrotesk.ttf#Schibsted Grotesk</FontFamily>
    <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/IBMPlexMono-Regular.ttf#IBM Plex Mono</FontFamily>
    <FontFamily x:Key="MonoSemiFont">ms-appx:///Assets/Fonts/IBMPlexMono-SemiBold.ttf#IBM Plex Mono SemiBold</FontFamily>
    <FontFamily x:Key="DisplayFont">ms-appx:///Assets/Fonts/SofiaSansExtraCondensed.ttf#Sofia Sans Extra Condensed</FontFamily>

    <x:Double x:Key="RailWidth">200</x:Double>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoSemiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="BandLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoSemiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <Style x:Key="Headline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WordsFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="LineHeight" Value="50" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-35" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="Numeral" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="FontSize" Value="100" />
        <Setter Property="LineHeight" Value="86" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WordsFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
    </Style>

    <Style x:Key="ItemTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Lead" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="27" />
    </Style>

    <Style x:Key="SmallNumeral" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="SignalNumeral" TargetType="TextBlock" BasedOn="{StaticResource SmallNumeral}">
        <Setter Property="Foreground" Value="{ThemeResource SignalTextBrush}" />
    </Style>

    <Style x:Key="SignalMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SignalTextBrush}" />
    </Style>

    <Style x:Key="StepProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="MinHeight" Value="3" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Foreground" Value="{ThemeResource SignalBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Rules and fills, so rows built in code still follow the theme. -->
    <Style x:Key="RowRule" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style x:Key="StrongRule" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0,1.5,0,0" />
    </Style>
    <Style x:Key="TrackFill" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TrackBrush}" />
    </Style>
    <Style x:Key="InkFill" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource InkBrush}" />
    </Style>
    <Style x:Key="SignalFill" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SignalBrush}" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
    </Style>

    <!-- Buttons: ink-filled primary, hairline outline secondary, plain text link. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource WordsFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource OnInkBrush}" />
        <Setter Property="Background" Value="{ThemeResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.86" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.72" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                          BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.75" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.6" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButtonPlain" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource WordsFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.65" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left-menu item: a short orange dash marks the current page. -->
    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource WordsFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource InkBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Dash.Opacity" Value="1" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource InkBrush}" />
                                        <Setter Target="Label.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="Dash" Width="16" Height="3" Fill="{ThemeResource SignalBrush}" Opacity="0" VerticalAlignment="Center" />
                        <ContentPresenter x:Name="Label" Grid.Column="1" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AskBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource WordsFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="16,13,16,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource FieldBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>
</ResourceDictionary>
